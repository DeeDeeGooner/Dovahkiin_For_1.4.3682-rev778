<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Dovahkiin</name>
  <packageId>erzou.dovahkiin</packageId>
  <author>erzou</author>
  <description>The Last Dragonborn comes to the rim.

One colonist, and only ever one, may awaken as the Dovahkiin. They learn the Thu'um from word walls buried in Nordic crypts, and they grow stronger by absorbing the souls of slain dragons — in knowledge and presence, never in raw size.

Dragons hate them on sight, allied or tamed. Alduin is out there.

Requires Harmony and HugsLib. Dragon content integrates with Dragon's Descent when present; large Nordic crypts require Vanilla Expanded Framework. The mod ships its own dragon and its own Alduin, so it is never an empty shell.</description>

  <supportedVersions>
    <li>1.4</li>
  </supportedVersions>

  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>UnlimitedHugs.HugsLib</packageId>
      <displayName>HugsLib</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/818773962</steamWorkshopUrl>
      <downloadUrl>https://github.com/UnlimitedHugs/RimworldHugsLib/releases/latest</downloadUrl>
    </li>
  </modDependencies>

  <!-- Load order per MODLIST.md, corrected in COMPAT.md §9.
       Late enough that our patches sit on top of Medieval Overhaul / Rimedieval filtering,
       and before RocketMan so its optimisation layer sees our finished defs. -->
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>Ludeon.RimWorld</li>
    <li>Ludeon.RimWorld.Royalty</li>
    <li>Ludeon.RimWorld.Ideology</li>
    <li>Ludeon.RimWorld.Biotech</li>
    <li>UnlimitedHugs.HugsLib</li>
    <li>jecrell.jecstools</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>onyxae.dragonsdescent</li>
    <li>Torann.ARimworldOfMagic</li>
    <li>DankPyon.Medieval.Overhaul</li>
    <li>ogam.rimedieval</li>
  </loadAfter>

  <loadBefore>
    <li>Krkr.RocketMan</li>
  </loadBefore>
</ModMetaData>

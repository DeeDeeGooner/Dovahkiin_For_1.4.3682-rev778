  <!-- ================= Clear Skies ================= -->
  <!--
    No target, no hostility, no line of sight.

    FIXED 2026-07-26: this def used to say "range -1 like vanilla SpeechBase", with no
    targetParams. That was wrong and the shout never fired once - the button was there, it
    could be clicked, and nothing whatsoever happened. No error, no exception, no log line.

    A no-target ability MUST declare <canTargetSelf>true</canTargetSelf> and a POSITIVE range.
    Without canTargetSelf, RimWorld auto-selects the caster as the target, the verb rejects it
    as invalid, and the cast silently never begins. Verified against the only three vanilla
    abilities that self-cast this way: SmokepopMech, FirefoampopMech and Neuroquake.

    SpeechBase really does use range -1 and no targetParams - but it is NOT a normal ability.
    It runs through ritual machinery (gizmoClass Command_AbilitySpeech, Precept_Ritual) that a
    plain self-cast has no access to. Copying its shape without its machinery gives a dead
    button, which is exactly what happened here and again in batch two.
  -->

  <AbilityDef Name="Dovahkiin_ClearSkiesBase" Abstract="True">
    <cooldownTicksRange>0</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <iconPath>UI/Abilities/Dovahkiin_Shout_ClearSkies</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>3.9</range>
      <warmupTime>1.2</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>


<!--
  SPEC.md 4.3, 4.4a - one AbilityDef per shout level.

  Vanilla AbilityDef throughout. No VEF, no JecsTools (RISKS.md section 2).

  Every shout inherits ShoutBase, which supplies:
    - CompProperties_AbilityRequiresCapacity/Talking. This is vanilla, and it is exactly
      SPEC.md 4.3's "a pawn with a destroyed jaw or in a coma cannot shout, and the UI must say
      why" - RimWorld greys out the gizmo and states the reason for free.
    - cooldownTicksRange 0, because the cooldown is SHARED across all shouts and owned by
      Hediff_TheVoice (SPEC.md 4.2). A per-ability cooldown would fight it.

  Icons are vanilla placeholders - logged in ART_TODO.md.
-->
<Defs>

  <AbilityDef Name="Dovahkiin_ShoutBase" Abstract="True">
    <cooldownTicksRange>0</cooldownTicksRange>
    <hostile>true</hostile>
    <targetRequired>true</targetRequired>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8</range>
      <warmupTime>0.9</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
      </targetParams>
    </verbProperties>
  </AbilityDef>


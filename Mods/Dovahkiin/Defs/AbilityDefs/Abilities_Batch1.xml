<Defs>

  <!-- ================= Frost Breath ================= -->

  <AbilityDef ParentName="Dovahkiin_ShoutBase">
    <defName>Dovahkiin_Ability_FrostBreath_1</defName>
    <label>fo</label>
    <description>Frost. A chilling cone that slows what it touches.</description>
    <iconPath>UI/Abilities/Dovahkiin_Shout_FrostBreath</iconPath>
    <comps>
      <li Class="Dovahkiin.CompProperties_Shout">
        <shout>Dovahkiin_Shout_FrostBreath</shout>
        <level>1</level>
      </li>
      <li Class="Dovahkiin.CompProperties_ShoutCone">
        <coneAngle>40</coneAngle>
        <!-- 7 -> 8, matching Fire Breath: the base grants verb range 8, so a 7-cell cone left a
             one-tile band that could be aimed at but never hit. -->
        <range>8</range>
        <!-- 14 -> 19 (+35%) -> 22 (+15%). Raised alongside fire, at a slightly lower rate. -->
        <damageAmount>22</damageAmount>
        <damageInstances>6</damageInstances>
        <snowDepth>0.12</snowDepth>
        <damageDef>Frostbite</damageDef>
        <appliedHediff>Dovahkiin_Chilled</appliedHediff>
        <appliedHediffSeverity>0.5</appliedHediffSeverity>
        <fleckDef>Dovahkiin_Fleck_FrostWave</fleckDef>
        <tint>(0.70, 0.90, 1.0)</tint>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Talking</capacity>
      </li>
    </comps>
  </AbilityDef>


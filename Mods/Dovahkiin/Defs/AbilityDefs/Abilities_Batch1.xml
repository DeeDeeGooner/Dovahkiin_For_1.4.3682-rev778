  <!-- ================= Whirlwind Sprint ================= -->
  <!-- Self-movement: not hostile, targets a location, no line-of-sight requirement beyond the dash. -->

  <!--
    CRITICAL: the jump MUST be done by verbClass Verb_CastAbilityJump, not by an ability comp.

    The first build moved the pawn from inside a comp's Apply(), which despawns the caster in
    the middle of its own cast. The flyer then never landed it and the pawn was destroyed
    outright - no corpse, no death letter, gone. Vanilla's Longjump (Biotech) does the whole
    thing in the verb and has NO comp for it; that is the supported path and it orders the job
    correctly. Verb_CastAbilityJump lives in Assembly-CSharp, so this needs no DLC.

    Do not reintroduce a movement comp here.
  -->
  <AbilityDef Name="Dovahkiin_SprintBase" Abstract="True">
    <cooldownTicksRange>0</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>true</targetRequired>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <iconPath>UI/Abilities/Dovahkiin_Shout_WhirlwindSprint</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbilityJump</verbClass>
      <label>whirlwind sprint</label>
      <violent>false</violent>
      <range>10</range>
      <warmupTime>0.4</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
  </AbilityDef>


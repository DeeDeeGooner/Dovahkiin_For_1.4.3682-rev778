  <!-- ================= Storm Call ================= -->
  <!--
    SPEC.md 4.4e. NO TARGET: the storm gathers over the Dovahkiin and seeks its own victims,
    it is not artillery placed on a spot. So this uses the self-cast shape, which means it
    needs canTargetSelf and a POSITIVE range - see the long note in Abilities_Batch2.xml
    about why a no-target ability without those is a dead button.

    Every targeting rule lives in Thing_StormCall, not here, because each strike re-checks
    them: pawns move, die, and duck under roofs mid-storm.

    Strike counts and durations come from DovahkiinTuningDef (stormCallStrikesByLevel,
    stormCallDurationTicksByLevel, stormCallRadius) so they retune without a rebuild.
  -->

  <AbilityDef Name="Dovahkiin_StormCallBase" Abstract="True">
    <cooldownTicksRange>0</cooldownTicksRange>
    <hostile>true</hostile>
    <targetRequired>false</targetRequired>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <iconPath>UI/Abilities/Dovahkiin_Shout_StormCall</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>3.9</range>
      <warmupTime>1.6</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>


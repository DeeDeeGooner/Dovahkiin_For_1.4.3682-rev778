  <!-- ================= Cyclone ================= -->
  <!--
    Asked for: very slight blunt damage, less even than Unrelenting Force, traded against a much
    longer stun, and a wave that is a turning swirl rather than a cone, in a grey so faint it is
    barely visible.

    Damage:  1 / 3 / 5 total, against Unrelenting Force's 3 / 7 / 12. Spread by the shared
             core-over-extremities rule so a few bruises land where a wind would throw someone,
             instead of crushing toes.
    Stun:    Unrelenting Force plus half again. It stuns 0 / 180 / 300, so this is 270 / 450 at
             levels 2 and 3. Level 1 gets 150 as a deliberate choice rather than zero: a level-1
             Cyclone with no stun and 1 damage would do nothing at all, and the stun is the
             entire point of the shout.
    Shape:   vortexRadius makes the wave a compact rotating COLUMN that travels along the line
             to the target - a tornado crossing the ground. The first build used a spiral arm
             sweeping outward, which playtest correctly called nothing like the shout: a vortex
             is LOCAL and moves, where a cone or spiral is a front that expands.
    Parts:   damageInstances halved again on the second round, to 1 / 2 / 2. The total damage is
             unchanged; it just lands on fewer body parts.
    Opacity: alphaScale 0.45, because colour alone cannot make a front fainter - the wave's
             alpha is computed per band, so it needs an explicit multiplier.
  -->

  <AbilityDef ParentName="Dovahkiin_ShoutBase">
    <defName>Dovahkiin_Ability_Cyclone_1</defName>
    <label>ven</label>
    <description>Wind. A turning gust that knocks the sense out of what it catches.</description>
    <iconPath>UI/Abilities/Dovahkiin_Shout_Cyclone</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>10</range>
      <warmupTime>0.9</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Dovahkiin.CompProperties_Shout">
        <shout>Dovahkiin_Shout_Cyclone</shout>
        <level>1</level>
      </li>
      <li Class="Dovahkiin.CompProperties_ShoutCone">
        <coneAngle>0</coneAngle>
        <vortexRadius>1.2</vortexRadius>
        <vortexSpinPerTick>26</vortexSpinPerTick>
        <alphaScale>0.45</alphaScale>
        <range>10</range>
        <damageAmount>1</damageAmount>
        <damageInstances>1</damageInstances>
        <spreadDamage>true</spreadDamage>
        <damageDef>Blunt</damageDef>
        <stunTicks>150</stunTicks>
        <waveCellsPerSecond>12</waveCellsPerSecond>
        <fleckDef>Dovahkiin_Fleck_CycloneWave</fleckDef>
        <tint>(0.70, 0.72, 0.76)</tint>
        <fleckScale>1.7</fleckScale>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Talking</capacity>
      </li>
    </comps>
  </AbilityDef>


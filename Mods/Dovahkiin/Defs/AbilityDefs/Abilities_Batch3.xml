    <defName>Dovahkiin_Ability_DrainVitality_1</defName>
    <label>gaan</label>
    <description>Stamina. The strength goes out of their limbs.</description>
    <iconPath>UI/Abilities/Dovahkiin_Shout_DrainVitality</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12</range>
      <warmupTime>1.0</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Dovahkiin.CompProperties_Shout">
        <shout>Dovahkiin_Shout_DrainVitality</shout>
        <level>1</level>
      </li>
      <li Class="Dovahkiin.CompProperties_ShoutCone">
        <coneAngle>45</coneAngle>
        <range>12</range>
        <damageAmount>0</damageAmount>
        <appliedHediff>Dovahkiin_VitalityDrained</appliedHediff>
        <appliedHediffSeverity>1</appliedHediffSeverity>
        <fleckDef>Dovahkiin_Fleck_DrainWave</fleckDef>
        <tint>(0.38, 0.13, 0.62)</tint>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">

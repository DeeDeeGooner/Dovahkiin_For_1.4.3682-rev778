<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    THE MEDIEVAL OVERHAUL VARIANT OF THE ANCIENT DRAGONBORN'S AXE.

    Present only when Medieval Overhaul is installed, via MayRequire. Absent it, this def
    simply never exists and the code falls back to Dovahkiin_AncientDragonbornAxe, which ships
    its own art. That is the CLAUDE.md rule: nothing but Harmony and HugsLib may be a hard
    requirement, and third-party defs are never overwritten - this is a NEW def beside theirs,
    not a patch on it.

    WHY IT IS FLAT ORANGE AND NOT THE ARMOUR'S BLUE-TO-ORANGE GRADIENT.
    Agreed explicitly with the user. Their greataxe texture is drawn with CutoutComplex, which
    supports a colour, and a colour is ONE value - it cannot carry a two-stop gradient. So the
    choice was their shape in a single colour, or our own art in the gradient, and the user
    chose the former to gain the mod's weapon and its Melee Animation tuning. The orange is
    C_EMBER from GenerateDragonAspect.ps1, (240,118,28), so the axe still reads as part of the
    same conjuration as the armour's lower half.

    Stats are copied from DankPyon_MeleeWeapon_Greataxe deliberately, so a player with the mod
    gets a weapon that behaves exactly like the one they know. It is NOT stuffed or quality-
    generated: like our own axe it exists for 1.5 in-game hours and is destroyed with its
    wielder, so crafting, deterioration and trade machinery should never touch it.
  -->
  <ThingDef MayRequire="dankpyon.medieval.overhaul">
    <defName>Dovahkiin_AncientDragonbornAxe_MO</defName>
    <label>spectral greataxe</label>
    <description>A two-handed axe of solid Thu'um, carried by a shard of the Dovahkiin's soul. It is not steel and it is not here for long.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <equipmentType>Primary</equipmentType>
    <altitudeLayer>Item</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Never</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <destroyOnDrop>true</destroyOnDrop>
    <tradeability>None</tradeability>
    <soundInteract>Standard_Pickup</soundInteract>
    <comps>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <!-- Medieval Overhaul's own texture, REFERENCED not copied, tinted ember. CutoutComplex is
         their shader and is what makes <color> take effect at all. -->
    <graphicData>
      <texPath>WeaponMelee/Axes/Greataxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(240, 118, 28)</color>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <statBases>
      <Mass>3</Mass>
      <MarketValue>0</MarketValue>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <!-- Their Greataxe's tools, verbatim, so it hits exactly as the familiar weapon does. -->
    <tools>
      <li>
        <label>shaft</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>31</power>
        <cooldownTime>3.2</cooldownTime>
        <armorPenetration>0.4</armorPenetration>
      </li>
    </tools>
  </ThingDef>

</Defs>

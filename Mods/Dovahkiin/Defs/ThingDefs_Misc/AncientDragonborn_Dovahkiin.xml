<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Dragon Aspect's Ancient Dragonborn - the pawn and his axe.

    NOT IN SPEC.md; specified by the user directly. The lifetime, cleanup and breath live in
    Hediff_AncientDragonborn; these defs only describe what he is made of.

    He is generated INVISIBLE (the hediff carries vanilla's HediffComp_Invisibility), so the
    only thing on screen is the level-3 Dragon Aspect armour following him and this axe. That
    is why he has no apparel and no apparel money - none of it would ever be seen, and every
    generated item is another object to clean up when he vanishes.
  -->

  <PawnKindDef>
    <defName>Dovahkiin_AncientDragonbornKind</defName>
    <label>ancient dragonborn</label>
    <race>Human</race>
    <combatPower>140</combatPower>
    <isFighter>true</isFighter>
    <canBeSapper>false</canBeSapper>
    <acceptArrestChanceFactor>0</acceptArrestChanceFactor>
    <!-- Any category would do; he is invisible and his backstory is never read. Tribal is
         chosen only because it exists in Core and carries no tech assumptions. -->
    <backstoryFilters>
      <li>
        <categories>
          <li>Tribal</li>
        </categories>
      </li>
    </backstoryFilters>
    <!-- Nothing generated onto him. The axe is equipped in code so it is always the right
         weapon, and apparel would be invisible anyway. -->
    <apparelMoney>0~0</apparelMoney>
    <weaponMoney>0~0</weaponMoney>
    <techHediffsChance>0</techHediffsChance>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <initialWillRange>0~0</initialWillRange>
    <initialResistanceRange>0~0</initialResistanceRange>
  </PawnKindDef>

  <!--
    The ghostly two-handed axe.

    Standalone rather than ParentName="BaseMeleeWeapon_Sharp_Quality" ON PURPOSE: the vanilla
    bases require stuff and quality, which would make this craftable-looking, tradeable, and
    subject to deterioration. It is a spectral weapon that exists for 1.5 in-game hours and is
    destroyed with its wielder, so none of that machinery should touch it.

    useHitPoints false so it cannot be damaged or deteriorate; it has no way to be repaired
    and a broken ghost axe is not a state worth modelling.
  -->
  <!--
    IT MUST BE HELD AND ANIMATED AS MEDIEVAL OVERHAUL'S HALBERD.

    The user's call, and everything below that looks like a magic number is copied from
    DankPyon_MeleeWeapon_Halberd rather than chosen: drawSize, Mass, both tools, and
    equippedAngleOffset 45 (which lives on its parent, DankPyon_Base_Sharp_Oversize).
    WeaponTweakData/ carries the halberd's Melee Animation entry verbatim, so the swing, the
    grip offset and the blade span are the halberd's too.

    THE ART HAD TO BE MIRRORED FOR THIS TO WORK, and that was measured, not assumed. Counting
    opaque pixels per quadrant, their halberd is topLeft 105 / topRight 5583 / botLeft 3252 /
    botRight 105 - bottom-left to top-right, head at top-right. Ours ran the other diagonal.
    Their tweak values are expressed in their texture's frame, so on a mirrored sprite the pawn
    would have gripped this by the blade.

    Labelled a HALBERD, not a greataxe: an axe head on a long shaft is what a halberd is, and
    it would be dishonest to show the player "greataxe" on something that hits, reaches and
    swings like a halberd.
  -->
  <ThingDef>
    <defName>Dovahkiin_AncientDragonbornAxe</defName>
    <label>spectral halberd</label>
    <description>A halberd of solid Thu'um, carried by a shard of the Dovahkiin's soul. It is not steel and it is not here for long.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <equipmentType>Primary</equipmentType>
    <altitudeLayer>Item</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Never</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <destroyOnDrop>true</destroyOnDrop>
    <!-- REQUIRED. Without it RimWorld logs "is equipment but has no CompEquippable" at load
         and then Pawn_EquipmentTracker.Notify_EquipmentAdded throws a NullReferenceException
         the moment anything tries to hold it - which is exactly what killed the first summon.
         Note there is NO CompProperties_Equippable type: vanilla's BaseWeapon declares it as a
         plain comp carrying compClass, the same shape HediffComp_Invisibility needs. -->
    <comps>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <!-- destroyOnDrop with the default tradeability of All is a config error in its own right.
         None is correct anyway: a spectral weapon that exists for 1.5 in-game hours has no
         business in a trade window. -->
    <tradeability>None</tradeability>
    <!-- Standard_Pickup, not a bladelike-weapon sound: there is no Interact_Bladelike* def in
         Core, and an unrecognised sound defName is an XML error at load. Checked, not assumed. -->
    <soundInteract>Standard_Pickup</soundInteract>
    <graphicData>
      <texPath>Things/Item/Equipment/DovahkiinAncientAxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- (1.5,1.5), the halberd's own drawSize - it inherits DankPyon_Base_Sharp_Oversize and
           is deliberately an oversize weapon. Our tweak data passes Scale 1.5 to match. -->
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <!-- 45, from DankPyon_Base_Sharp_Oversize. This is the orientation in the pawn's hand and
         is the whole reason the sprite had to be mirrored to their diagonal. -->
    <equippedAngleOffset>45</equippedAngleOffset>
    <statBases>
      <Mass>2.75</Mass>
      <MarketValue>0</MarketValue>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <!--
      DankPyon_MeleeWeapon_Halberd's tools, verbatim. A player with Medieval Overhaul gets a
      weapon that hits exactly like the halberd they know; a player without it still gets a
      properly weighted polearm rather than numbers invented on the spot. No MayRequire and no
      fallback path is needed, because we borrow the BEHAVIOUR and ship our own art.
    -->
    <tools>
      <li>
        <label>shaft</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>27</power>
        <cooldownTime>2.9</cooldownTime>
        <armorPenetration>0.3</armorPenetration>
      </li>
    </tools>
  </ThingDef>

</Defs>

    <cooldownTicksByLevel><li>3000</li><li>5000</li><li>7500</li></cooldownTicksByLevel>
    <availableToDragons>false</availableToDragons>
    <availableToUndead>false</availableToUndead>
  </Dovahkiin.ShoutDef>

</Defs>
